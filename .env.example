# Database
# App traffic MUST use DigitalOcean's Connection Pool URI (PgBouncer, usually
# port 25061). On DO the path is the *pool name* (e.g. /pooler), not the
# Postgres database name — copy the pool string from the DO UI. Add
# pgbouncer=true for Prisma.
#
# DIRECT_URL must be the *direct* primary (port 25060, real DB name e.g.
# defaultdb) for prisma migrate. Never set DIRECT_URL to the same pooler URI
# as DATABASE_URL — migrations need a non-pooled connection.
#
# connection_limit: Prisma's pool size for THIS process. Default 5 when omitted
# (see prisma/prisma.service.ts). Local + Railway share one DO max_connections
# budget (~25 on small plans) — if you run Nest locally against prod, set
# connection_limit=2 (or stop local) or you will see
# "FATAL: sorry, too many clients already" and 499/500 storms.
# Read-only check: npx ts-node scripts/check-pg-connections.ts
DATABASE_URL=postgresql://user:password@host-do-user-xxx.db.ondigitalocean.com:25061/pooler?sslmode=require&pgbouncer=true&connection_limit=5
DIRECT_URL=postgresql://user:password@host-do-user-xxx.db.ondigitalocean.com:25060/defaultdb?sslmode=require

# Server
PORT=8080
NODE_ENV=development

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Redis — required in production when running multiple backend instances.
# Socket.IO uses Redis pub/sub to sync chat events across pods.
# Omit for local single-instance dev (in-memory adapter is used automatically).
REDIS_URL=redis://localhost:6379

# Brevo SMTP (OTP emails)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
BREVO_FROM_EMAIL=no-reply@snaeducationalservices.com
BREVO_FROM_NAME=TAFS
# Optional — Brevo REST API (not used by mailer currently)
# BREVO_API_KEY=

# Daily digest (deposits + staff/student clock-in/out) — sent 10pm PKT daily
DAILY_DIGEST_RECIPIENTS=admin1@example.com,admin2@example.com

# Chat socket verification script (npm run verify:chat-socket)
# API_BASE_URL=http://localhost:8080
# VERIFY_FAMILY_ID=3469
# PARENT_USERNAME=
# PARENT_PASSWORD=
# STAFF_USERNAME=
# STAFF_PASSWORD=

# Coral9 integration — this box runs Coral9's scheduled jobs (see
# src/modules/attendance/coral9-scheduler.service.ts). Real values live in the
# server's .env, never here.
CORAL9_DATABASE_URL=
CORAL9_FLUSH_SECRET=
CORAL9_CRON_SECRET=

# UBL bill inquiry/payment API (TAFSD-294) — credentials UBL sends in X-UBL-User / X-UBL-Password
UBL_SERVICE_USER_ID=
UBL_SERVICE_PASSWORD=
# 10-digit 1Bill biller prefix issued by UBL; a placeholder is printed until this is set
UBL_1BILL_PREFIX=
