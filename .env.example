# Database
DATABASE_URL=postgresql://user:password@localhost:5432/tafs

# Server
PORT=8080
NODE_ENV=development

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Redis — required in production when running multiple backend instances.
# Socket.IO uses Redis pub/sub to sync chat events across pods.
# Omit for local single-instance dev (in-memory adapter is used automatically).
REDIS_URL=redis://localhost:6379

# Resend (OTP emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@tafs.edu.pk
RESEND_FROM_NAME=TAFS

# Chat socket verification script (npm run verify:chat-socket)
# API_BASE_URL=http://localhost:8080
# VERIFY_FAMILY_ID=3469
# PARENT_USERNAME=
# PARENT_PASSWORD=
# STAFF_USERNAME=
# STAFF_PASSWORD=
