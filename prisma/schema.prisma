  entity_id   String    @db.VarChar(50)
  action      String    @db.VarChar(50)
  field       String?   @db.VarChar(100)
  old_value   String?
  new_value   String?
  changed_by  String    @db.VarChar(255)
  changed_at  DateTime  @default(now())
  note        String?
  student_id  Int?
  section     String?   @db.VarChar(50)
  students    students? @relation(fields: [student_id], references: [cc])

  @@index([changed_at(sort: Desc)])
  @@index([entity_type, entity_id])
  @@index([student_id])
  @@index([section])
}

model class_check_in_schedules {
  id                 Int      @id @default(autoincrement())
  class_id           Int
  campus_id          Int
  expected_check_in  DateTime @db.Time(0)
  late_grace_minutes Int      @default(0)
  effective_from     DateTime @db.Date
  created_by         String?
  created_at         DateTime @default(now()) @db.Timestamp(6)
  campuses           campuses @relation(fields: [campus_id], references: [id], onDelete: Cascade)
  classes            classes  @relation(fields: [class_id], references: [id], onDelete: Cascade)

  @@unique([class_id, effective_from])
  @@index([campus_id, effective_from])
}

model employee_notice_posts {
  id                Int                          @id @default(autoincrement())
  posted_by         String                       @db.VarChar(255)
  title             String?                      @db.VarChar(255)
  body              String
  target_roles      StaffRole[]                  @default([])
  campus_ids        Int[]                        @default([])
  media_urls        Json?                        @default("[]")
  media_types       Json?                        @default("[]")
  is_pinned         Boolean                      @default(false)
  posted_at         DateTime                     @default(now()) @db.Timestamp(6)
  expires_at        DateTime?                    @db.Timestamp(6)
  deleted_at        DateTime?                    @db.Timestamp(6)
  class_ids         Int[]                        @default([])
  section_ids       Int[]                        @default([])
  employee_id       Int?
  post_reads        employee_notice_post_reads[]
  employee_profiles employee_profiles?           @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  users             users                        @relation(fields: [posted_by], references: [id])

  @@index([posted_at(sort: Desc)])
  @@index([target_roles], type: Gin)
  @@index([campus_ids], type: Gin)
  @@index([class_ids], type: Gin)
  @@index([section_ids], type: Gin)
  @@index([employee_id])
}

model employee_notice_post_reads {
  id      Int                   @id @default(autoincrement())
  post_id Int
  user_id String                @db.VarChar(255)
  read_at DateTime              @default(now()) @db.Timestamp(6)
  posts   employee_notice_posts @relation(fields: [post_id], references: [id], onDelete: Cascade)
  users   users                 @relation(fields: [user_id], references: [id])

  @@unique([post_id, user_id])
}

model otp_codes {
  id           String      @id
  purpose      otp_purpose
  email        String      @db.VarChar(100)
  code_hash    String      @db.VarChar(255)
  family_id    Int?
  user_id      String?
  cnic         String?     @db.VarChar(15)
  attempts     Int         @default(0)
  max_attempts Int         @default(5)
  consumed_at  DateTime?
  expires_at   DateTime
  created_at   DateTime    @default(now()) @db.Timestamp(6)

  @@index([family_id, purpose], map: "idx_otp_codes_family")
  @@index([email, purpose, consumed_at, expires_at], map: "idx_otp_codes_lookup")
  @@index([user_id, purpose], map: "idx_otp_codes_user")
}

model unconfirmed_admissions {
  id              Int       @id @default(autoincrement())
  full_name       String    @db.VarChar(200)
  date_of_birth   DateTime  @db.Date
  gender          String    @db.VarChar(20)
  address         String?
  campus_id       Int?
  photograph_url  String?
  deposit_amount  Decimal   @db.Decimal(10, 2)
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  created_by      String?   @db.VarChar(255)
  guardians       Json?     @default("[]")
  academic_system String?   @db.VarChar(20)
  requested_grade String?   @db.VarChar(20)
  admin_notes     String?
  campuses        campuses? @relation(fields: [campus_id], references: [id], onUpdate: NoAction)
}

